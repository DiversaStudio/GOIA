DATABASE_URL=postgresql://postgres:postgres@db:5432/goia
DATABASE_ASYNC_URL=postgresql+asyncpg://postgres:postgres@db:5432/goia
DATABASE_MAX_OVERFLOW=100
DATABASE_POOL_SIZE=10

JWT_SECRET_KEY=your-super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE=86400  # 24 hours in seconds
JWT_REFRESH_TOKEN_EXPIRE=604800  # 7 days

SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_VERIFICATION_ENABLED=true

# Tenant settings
DEFAULT_TENANT_ID=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000

# Security
Csrf_ENABLED=true
TrustHosts=true
DEBUG=false
